%% Use Case Diagram - Sistem Akademik Sevima-Mini
usecaseDiagram
    actor CalonMahasiswa as "Calon Mahasiswa"
    actor Mahasiswa as "Mahasiswa Aktif"
    actor Dosen as "Dosen"
    actor Admin as "Admin Akademik"

    rectangle "Sistem Informasi Akademik (SEVIMA-Mini)" {
        usecase "Login & Logout" as UC_Auth
        
        %% PMB Use Cases
        usecase "Pendaftaran PMB" as UC_PMB
        usecase "Bayar Invoice PMB" as UC_BayarPMB
        usecase "Cek Status Seleksi" as UC_CekPMB

        %% KRS & Academic Use Cases
        usecase "Isi Kartu Rencana Studi (KRS)" as UC_KRS
        usecase "Bayar Invoice KRS" as UC_BayarKRS
        usecase "Lihat Jadwal Kuliah" as UC_Jadwal
        usecase "Lihat Nilai & KHS" as UC_Nilai

        %% Dosen Use Cases
        usecase "Kelola & Input Nilai Mahasiswa" as UC_InputNilai
        usecase "Lihat Jadwal Mengajar" as UC_JadwalDosen

        %% Admin Use Cases
        usecase "Kelola Data Pengguna" as UC_KelolaUser
        usecase "Kelola Katalog Course & Kelas" as UC_KelolaCourse
        usecase "Verifikasi Pembayaran & Pendaftaran" as UC_Verifikasi
    }

    %% Calon Mahasiswa associations
    CalonMahasiswa --> UC_Auth
    CalonMahasiswa --> UC_PMB
    CalonMahasiswa --> UC_BayarPMB
    CalonMahasiswa --> UC_CekPMB

    %% Mahasiswa associations
    Mahasiswa --> UC_Auth
    Mahasiswa --> UC_KRS
    Mahasiswa --> UC_BayarKRS
    Mahasiswa --> UC_Jadwal
    Mahasiswa --> UC_Nilai

    %% Dosen associations
    Dosen --> UC_Auth
    Dosen --> UC_InputNilai
    Dosen --> UC_JadwalDosen

    %% Admin associations
    Admin --> UC_Auth
    Admin --> UC_KelolaUser
    Admin --> UC_KelolaCourse
    Admin --> UC_Verifikasi
