```mermaid
classDiagram
    direction TB

    %% User Hierarchy (Inheritance - lolos uji "is a")
    class User {
        <<abstract>>
        # String id
        # String nama
        # String email
        + login()
        + logout()
    }

    class Mahasiswa {
        - String nim
        - String jurusan
        + getMahasiswaInfo()
    }

    class Dosen {
        - String nip
        - String keahlian
        + getDosenInfo()
    }

    class Admin {
        - String role
        + manageSystem()
    }

    class CalonMahasiswa {
        - String noPendaftaran
        + submitRegistration()
    }

    %% Core Classes
    class Course {
        - String kode
        - String nama
        - int sks
        + getCourseDetails()
    }

    class Enrollment {
        - String idEnrollment
        - Date tanggalDaftar
        - String status
        + processEnrollment()
    }

    class Schedule {
        - String hari
        - String jam
        - String ruangan
        + updateSchedule()
    }

    class Grade {
        - double nilaiAngka
        - String nilaiHuruf
        - double bobot
        + calculateFinalGrade()
    }

    class Payment {
        - String idPayment
        - double jumlah
        - Date tanggalBayar
        - String statusBayar
        + verifyPayment()
        + generateReceipt()
    }

    %% Inheritance
    User <|-- Mahasiswa
    User <|-- Dosen
    User <|-- Admin
    User <|-- CalonMahasiswa

    %% Aggregation (relasi lemah)
    Course "1" o-- "*" Schedule : memiliki
    Dosen "1" o-- "*" Schedule : mengajar
    Course "1" o-- "*" Course : prasyaratUntuk
    Course "*" o-- "1" Course : prasyaratDari

    %% Association (bukan composition untuk Grade - nilai akademik bersifat permanen)
    Enrollment "1" --> "0..1" Grade : memiliki
    Mahasiswa "1" --> "*" Enrollment : melakukan
    Course "1" --> "*" Enrollment : dimilikiOleh
    Dosen "1" --> "*" Course : mengajar

    %% Payment relationships
    Mahasiswa "1" --> "*" Payment : melakukan
    CalonMahasiswa "1" --> "*" Payment : melakukan
    Payment "1" --> "1" Enrollment : untuk
```