classDiagram
    direction TB

    %% User Hierarchy (Polymorphism & CalonMahasiswa lifecycle)
    class User {
        <<abstract>>
        # String id
        # String nama
        # String email
        + login()
        + logout()
        + getInfo()*
    }

    class Mahasiswa {
        - String nim
        - String jurusan
        + getInfo()
    }

    class Dosen {
        - String nip
        - String keahlian
        + getInfo()
    }

    class Admin {
        - String role
        + getInfo()
    }

    class CalonMahasiswa {
        - String noPendaftaran
        - String statusSeleksi
        + getInfo()
        + registerAsMahasiswa()
    }

    %% Academic Catalog & Offering
    class Course {
        - String kode
        - String nama
        - int sks
        + getCourseDetails()
    }

    class Kelas {
        - String idKelas
        - String namaKelas
        - String semester
        - int kapasitas
        + getKelasInfo()
    }

    class Schedule {
        - String hari
        - String jam
        - String ruangan
        + updateSchedule()
    }

    class Enrollment {
        - String idEnrollment
        - String status
        + processEnrollment()
    }

    class Grade {
        - double nilaiAngka
        - String nilaiHuruf
        - double bobot
        + calculateFinalGrade()
    }

    %% Pendaftaran Hierarchy (Cleaned of duplication)
    class Pendaftaran {
        <<abstract>>
        # String idPendaftaran
        # Date tanggalDaftar
        # String status
        + submitPendaftaran()
        + getStatus()
    }

    class PendaftaranPMB {
        - String pilihanJurusan
        + verifikasiPMB()
    }

    class PendaftaranKRS {
        - int totalSks
        + prosesKRS()
    }

    %% Payment Hierarchy (Cleaned of duplication)
    class Payment {
        <<abstract>>
        # String idPayment
        # double jumlah
        # Date tanggalBayar
        # String statusBayar
        + verifyPayment()
        + generateReceipt()
    }

    class PembayaranPMB {
        + buatInvoicePMB()
    }

    class PembayaranKRS {
        + buatInvoiceKRS()
    }

    %% Inheritance
    User <|-- Mahasiswa
    User <|-- Dosen
    User <|-- Admin
    User <|-- CalonMahasiswa
    Pendaftaran <|-- PendaftaranPMB
    Pendaftaran <|-- PendaftaranKRS
    Payment <|-- PembayaranPMB
    Payment <|-- PembayaranKRS

    %% Relationships & Cardinalities (Cleaned & Optimized)
    Course "1" o-- "*" Kelas : katalogKelas
    Kelas "1" *-- "*" Schedule : memilikiJadwal
    Dosen "1" --> "*" Kelas : mengajar
    Course "*" -- "*" Course : prasyarat

    Mahasiswa "1" --> "*" Enrollment : melakukan
    Kelas "1" --> "*" Enrollment : menampung
    Enrollment "1" *-- "0..1" Grade : memilikiNilai

    CalonMahasiswa "1" --> "1" PendaftaranPMB : melakukan
    Mahasiswa "1" --> "*" PendaftaranKRS : melakukan
    PendaftaranKRS "1" --> "1..*" Enrollment : menghasilkan
    PendaftaranPMB "1" --> "1" PembayaranPMB : memerlukan
    PendaftaranKRS "1" --> "1" PembayaranKRS : memerlukan